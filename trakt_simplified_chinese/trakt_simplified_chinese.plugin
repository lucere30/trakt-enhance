#!name=Trakt 增强
#!desc=Trakt App 各页面从英文改为简体中文或港台繁体，包括海报；历史页面剧集类别的已观看记录按电视剧合并；Trakt 的影片详情页添加 EplayerX、Forward、Infuse、Rex 跳转按钮；部分兼容其它使用了 Trakt API 的应用。
#!icon=https://raw.githubusercontent.com/lucere30/trakt-enhance/main/trakt_simplified_chinese/images/trakt.webp
#!homepage=https://github.com/lucere30/trakt-enhance
#!openUrl=https://apps.apple.com/app/id1514873602
#!author=DemoJameson
#!updatedTime=2026-10-13 17:22:18

[Argument]
fakeVipEnabled = switch, "true", tag=伪装成 VIP, desc=启用后伪装为 Trakt VIP 会员，移除 App 中的广告
chineseLocale = select,"简体中文","繁體中文（台灣）","繁體中文（香港）",tag=目标语言,desc=选择目标语言：简体中文、繁體中文（台灣）或繁體中文（香港）
chineseOnlyTranslation = switch, "true", tag=只翻译中文影视, desc=开启后只翻译原始语言为中文的剧集和电影；其他语言的标题、简介、集数、评论、演职员等保留 Trakt 原文。海报见「中文影视用中文原海报」和「海报语言」
translationEngine = select,"谷歌翻译","DeepLX","关闭",tag=翻译部分文本,desc=选择翻译引擎：谷歌翻译（快，需翻墙）、DeepLX（慢，可直连）、关闭
peopleTranslationEnabled = switch, "true", tag=人物页翻译, desc=人物详情页是否翻译演员名和简介，不受「只翻译中文影视」影响；人物搜索见「人物搜索翻译」，影视页里的演职员表仍按该影视的语言决定
personSearchTranslationMode = select,"全部翻译","华人和日韩名","仅华人名","关闭",tag=人物搜索翻译,desc=人物搜索结果（含本月生日人物列表）翻译谁的名字和简介，不受「只翻译中文影视」影响。华人和日韩名：TMDb 中文名不带「·」的人；仅华人名：再排除出生在日本、韩国的人；其他人保留原文。与「人物页翻译」互不影响
characterTranslationEnabled = switch, "true", tag=用豆瓣翻译角色名, desc=启用后会用豆瓣翻译角色名
chinesePosterEnabled = switch, "true", tag=中文影视用中文原海报, desc=开启后原始语言为中文的剧集和电影固定使用 TMDb 中文海报（优先原产地区版本，如台剧用台版、港片用港版），不受「海报语言」影响；TMDb 没有中文海报时保留 Trakt 原图
posterImageMode = select,"原片语言","简体中文","繁體中文（台灣）","繁體中文（香港）","原图",tag=海报语言,desc=开启「中文影视用中文原海报」时只对其他语言的影视生效。原片语言使用 TMDb 影片原始语言图片；中文按所选语言优先匹配海报；原图保留 Trakt 原图
historyEpisodesMergedByShow = switch, "true", tag=历史剧集按电视剧合并, desc=启用后会将历史页面电视剧类别的观看记录按电视剧合并
eplayerxButtonOrder = select,"1","2","3","4","0",tag=EplayerX 跳转按钮,desc=序号代表在 Trakt 中的排序位置，0 不显示，默认 1
forwardButtonOrder = select,"1","2","3","4","0",tag=Forward 跳转按钮,desc=序号代表在 Trakt 中的排序位置，0 不显示，默认 2
infuseButtonOrder = select,"1","2","3","4","0",tag=Infuse 跳转按钮,desc=序号代表在 Trakt 中的排序位置，0 不显示，默认 3
rexButtonOrder = select,"1","2","3","4","0",tag=Rex 跳转按钮,desc=序号代表在 Trakt 中的排序位置，0 不显示，默认 4
backendBaseUrl = input, "https://proxy-modules.demojameson.de5.net", tag=翻译缓存接口, desc=用于批量获取 Trakt 的中文翻译，一般留空即可
tamperAppAuthorizationEnabled = switch, "false", tag=篡改应用授权, desc=启用后将第三方 App 的 Trakt 授权篡改成 Trakt 官方 App，规避应用连接数的限制，请仅在需要时开启
debugMode = select,"关闭","禁用本地缓存","禁用远端缓存","禁用所有缓存",tag=调试模式,desc=禁用本地缓存：不读写持久化存储；禁用远端缓存：不请求后端缓存接口；禁用所有缓存：两者皆禁用

[Script]
# 篡改第三方 App 的 Trakt OAuth 设备码和 token 请求
http-request ^https:\/\/apiz?\.trakt\.tv\/oauth\/(?:device\/code|device\/token|token)(?:\?.*)?$ script-path=https://raw.githubusercontent.com/lucere30/trakt-enhance/main/trakt_simplified_chinese/trakt_simplified_chinese.js, requires-body=true, timeout=10, argument=[{fakeVipEnabled},{chineseLocale},{posterImageMode},{translationEngine},{characterTranslationEnabled},{historyEpisodesMergedByShow},{eplayerxButtonOrder},{forwardButtonOrder},{infuseButtonOrder},{rexButtonOrder},{backendBaseUrl},{tamperAppAuthorizationEnabled},{debugMode},{chineseOnlyTranslation},{peopleTranslationEnabled},{personSearchTranslationMode},{chinesePosterEnabled}], tag=Trakt OAuth Client Rewrite
# 篡改第三方 App 的 Trakt Auth token 请求
http-request ^https:\/\/auth\.trakt\.tv\/oauth\/token(?:\?.*)?$ script-path=https://raw.githubusercontent.com/lucere30/trakt-enhance/main/trakt_simplified_chinese/trakt_simplified_chinese.js, requires-body=true, timeout=10, argument=[{fakeVipEnabled},{chineseLocale},{posterImageMode},{translationEngine},{characterTranslationEnabled},{historyEpisodesMergedByShow},{eplayerxButtonOrder},{forwardButtonOrder},{infuseButtonOrder},{rexButtonOrder},{backendBaseUrl},{tamperAppAuthorizationEnabled},{debugMode},{chineseOnlyTranslation},{peopleTranslationEnabled},{personSearchTranslationMode},{chinesePosterEnabled}], tag=Trakt Auth OAuth Client Rewrite
# 篡改第三方 App 的 trakt.tv token 请求
http-request ^https:\/\/trakt\.tv\/oauth\/token(?:\?.*)?$ script-path=https://raw.githubusercontent.com/lucere30/trakt-enhance/main/trakt_simplified_chinese/trakt_simplified_chinese.js, requires-body=true, timeout=10, argument=[{fakeVipEnabled},{chineseLocale},{posterImageMode},{translationEngine},{characterTranslationEnabled},{historyEpisodesMergedByShow},{eplayerxButtonOrder},{forwardButtonOrder},{infuseButtonOrder},{rexButtonOrder},{backendBaseUrl},{tamperAppAuthorizationEnabled},{debugMode},{chineseOnlyTranslation},{peopleTranslationEnabled},{personSearchTranslationMode},{chinesePosterEnabled}], tag=Trakt Web OAuth Client Rewrite
# 替换第三方 App 的 trakt.tv 授权地址
http-request ^https:\/\/trakt\.tv\/oauth\/authorize(?:\?.*)?$ script-path=https://raw.githubusercontent.com/lucere30/trakt-enhance/main/trakt_simplified_chinese/trakt_simplified_chinese.js, timeout=10, argument=[{fakeVipEnabled},{chineseLocale},{posterImageMode},{translationEngine},{characterTranslationEnabled},{historyEpisodesMergedByShow},{eplayerxButtonOrder},{forwardButtonOrder},{infuseButtonOrder},{rexButtonOrder},{backendBaseUrl},{tamperAppAuthorizationEnabled},{debugMode},{chineseOnlyTranslation},{peopleTranslationEnabled},{personSearchTranslationMode},{chinesePosterEnabled}], tag=Trakt Web OAuth Authorize Rewrite
# 替换第三方 App 的 auth.trakt.tv 授权地址
http-request ^https:\/\/auth\.trakt\.tv\/oauth\/authorize(?:\?.*)?$ script-path=https://raw.githubusercontent.com/lucere30/trakt-enhance/main/trakt_simplified_chinese/trakt_simplified_chinese.js, timeout=10, argument=[{fakeVipEnabled},{chineseLocale},{posterImageMode},{translationEngine},{characterTranslationEnabled},{historyEpisodesMergedByShow},{eplayerxButtonOrder},{forwardButtonOrder},{infuseButtonOrder},{rexButtonOrder},{backendBaseUrl},{tamperAppAuthorizationEnabled},{debugMode},{chineseOnlyTranslation},{peopleTranslationEnabled},{personSearchTranslationMode},{chinesePosterEnabled}], tag=Trakt Auth OAuth Authorize Rewrite
# 将 Trakt 官方授权回调还原为第三方 App 回调
http-response ^https:\/\/auth\.trakt\.tv\/api\/auth\/oauth2\/authorize(?:\?.*)?$ script-path=https://raw.githubusercontent.com/lucere30/trakt-enhance/main/trakt_simplified_chinese/trakt_simplified_chinese.js, timeout=10, argument=[{fakeVipEnabled},{chineseLocale},{posterImageMode},{translationEngine},{characterTranslationEnabled},{historyEpisodesMergedByShow},{eplayerxButtonOrder},{forwardButtonOrder},{infuseButtonOrder},{rexButtonOrder},{backendBaseUrl},{tamperAppAuthorizationEnabled},{debugMode},{chineseOnlyTranslation},{peopleTranslationEnabled},{personSearchTranslationMode},{chinesePosterEnabled}], tag=Trakt OAuth Callback Rewrite
# 将 trakt.tv 官方授权回调还原为第三方 App 回调
http-response ^https:\/\/trakt\.tv\/api\/auth\/oauth2\/authorize(?:\?.*)?$ script-path=https://raw.githubusercontent.com/lucere30/trakt-enhance/main/trakt_simplified_chinese/trakt_simplified_chinese.js, timeout=10, argument=[{fakeVipEnabled},{chineseLocale},{posterImageMode},{translationEngine},{characterTranslationEnabled},{historyEpisodesMergedByShow},{eplayerxButtonOrder},{forwardButtonOrder},{infuseButtonOrder},{rexButtonOrder},{backendBaseUrl},{tamperAppAuthorizationEnabled},{debugMode},{chineseOnlyTranslation},{peopleTranslationEnabled},{personSearchTranslationMode},{chinesePosterEnabled}], tag=Trakt Web OAuth Callback Rewrite
# 记录篡改流程签发的 Trakt Auth access/refresh token
http-response ^https:\/\/auth\.trakt\.tv\/oauth\/token(?:\?.*)?$ script-path=https://raw.githubusercontent.com/lucere30/trakt-enhance/main/trakt_simplified_chinese/trakt_simplified_chinese.js, requires-body=true, timeout=10, argument=[{fakeVipEnabled},{chineseLocale},{posterImageMode},{translationEngine},{characterTranslationEnabled},{historyEpisodesMergedByShow},{eplayerxButtonOrder},{forwardButtonOrder},{infuseButtonOrder},{rexButtonOrder},{backendBaseUrl},{tamperAppAuthorizationEnabled},{debugMode},{chineseOnlyTranslation},{peopleTranslationEnabled},{personSearchTranslationMode},{chinesePosterEnabled}], tag=Trakt Auth OAuth Token Response Rewrite
# 记录篡改流程签发的 trakt.tv access/refresh token
http-response ^https:\/\/trakt\.tv\/oauth\/token(?:\?.*)?$ script-path=https://raw.githubusercontent.com/lucere30/trakt-enhance/main/trakt_simplified_chinese/trakt_simplified_chinese.js, requires-body=true, timeout=10, argument=[{fakeVipEnabled},{chineseLocale},{posterImageMode},{translationEngine},{characterTranslationEnabled},{historyEpisodesMergedByShow},{eplayerxButtonOrder},{forwardButtonOrder},{infuseButtonOrder},{rexButtonOrder},{backendBaseUrl},{tamperAppAuthorizationEnabled},{debugMode},{chineseOnlyTranslation},{peopleTranslationEnabled},{personSearchTranslationMode},{chinesePosterEnabled}], tag=Trakt Web OAuth Token Response Rewrite
# 处理播放器 DeepLink 跳转
http-request ^https:\/\/loon-plugins\.demojameson\.de5\.net\/api\/redirect\?.*$ script-path=https://raw.githubusercontent.com/lucere30/trakt-enhance/main/trakt_simplified_chinese/trakt_simplified_chinese.js, timeout=10, argument=[{fakeVipEnabled},{chineseLocale},{posterImageMode},{translationEngine},{characterTranslationEnabled},{historyEpisodesMergedByShow},{eplayerxButtonOrder},{forwardButtonOrder},{infuseButtonOrder},{rexButtonOrder},{backendBaseUrl},{tamperAppAuthorizationEnabled},{debugMode},{chineseOnlyTranslation},{peopleTranslationEnabled},{personSearchTranslationMode},{chinesePosterEnabled}], tag=Direct Redirect
# SofaTime 中自定义播放器 Logo
http-request ^https:\/\/image\.tmdb\.org\/t\/p\/w342\/[a-z0-9_-]+_logo\.webp(?:\?.*)?$ script-path=https://raw.githubusercontent.com/lucere30/trakt-enhance/main/trakt_simplified_chinese/trakt_simplified_chinese.js, timeout=10, argument=[{fakeVipEnabled},{chineseLocale},{posterImageMode},{translationEngine},{characterTranslationEnabled},{historyEpisodesMergedByShow},{eplayerxButtonOrder},{forwardButtonOrder},{infuseButtonOrder},{rexButtonOrder},{backendBaseUrl},{tamperAppAuthorizationEnabled},{debugMode},{chineseOnlyTranslation},{peopleTranslationEnabled},{personSearchTranslationMode},{chinesePosterEnabled}], tag=TMDB Logo Redirect
# 拦截 sync/history/episodes 请求，放大 limit
http-request ^https:\/\/apiz?\.trakt\.tv\/sync\/history\/episodes\/?(\?.*)?$ script-path=https://raw.githubusercontent.com/lucere30/trakt-enhance/main/trakt_simplified_chinese/trakt_simplified_chinese.js, timeout=10, argument=[{fakeVipEnabled},{chineseLocale},{posterImageMode},{translationEngine},{characterTranslationEnabled},{historyEpisodesMergedByShow},{eplayerxButtonOrder},{forwardButtonOrder},{infuseButtonOrder},{rexButtonOrder},{backendBaseUrl},{tamperAppAuthorizationEnabled},{debugMode},{chineseOnlyTranslation},{peopleTranslationEnabled},{personSearchTranslationMode},{chinesePosterEnabled}], tag=Trakt Sync History Episodes Request
# 拦截 history/episodes 请求，放大 limit
http-request ^https:\/\/apiz?\.trakt\.tv\/users\/[^\/]+?\/history\/episodes\/?(\?.*)?$ script-path=https://raw.githubusercontent.com/lucere30/trakt-enhance/main/trakt_simplified_chinese/trakt_simplified_chinese.js, timeout=10, argument=[{fakeVipEnabled},{chineseLocale},{posterImageMode},{translationEngine},{characterTranslationEnabled},{historyEpisodesMergedByShow},{eplayerxButtonOrder},{forwardButtonOrder},{infuseButtonOrder},{rexButtonOrder},{backendBaseUrl},{tamperAppAuthorizationEnabled},{debugMode},{chineseOnlyTranslation},{peopleTranslationEnabled},{personSearchTranslationMode},{chinesePosterEnabled}], tag=Trakt History Episodes Request
# 拦截带季号的请求，记录当前浏览季
http-request ^https:\/\/apiz?\.trakt\.tv\/shows\/[^\/]+\/seasons\/\d+(?:\/.*|\?.*)?$ script-path=https://raw.githubusercontent.com/lucere30/trakt-enhance/main/trakt_simplified_chinese/trakt_simplified_chinese.js, timeout=10, argument=[{fakeVipEnabled},{chineseLocale},{posterImageMode},{translationEngine},{characterTranslationEnabled},{historyEpisodesMergedByShow},{eplayerxButtonOrder},{forwardButtonOrder},{infuseButtonOrder},{rexButtonOrder},{backendBaseUrl},{tamperAppAuthorizationEnabled},{debugMode},{chineseOnlyTranslation},{peopleTranslationEnabled},{personSearchTranslationMode},{chinesePosterEnabled}], tag=Trakt Current Season Request
# 按篡改流程签发的 access token 改写 trakt-api-key
http-request ^https:\/\/apiz?\.trakt\.tv\/(?!oauth\/).*$ script-path=https://raw.githubusercontent.com/lucere30/trakt-enhance/main/trakt_simplified_chinese/trakt_simplified_chinese.js, timeout=10, argument=[{fakeVipEnabled},{chineseLocale},{posterImageMode},{translationEngine},{characterTranslationEnabled},{historyEpisodesMergedByShow},{eplayerxButtonOrder},{forwardButtonOrder},{infuseButtonOrder},{rexButtonOrder},{backendBaseUrl},{tamperAppAuthorizationEnabled},{debugMode},{chineseOnlyTranslation},{peopleTranslationEnabled},{personSearchTranslationMode},{chinesePosterEnabled}], tag=Trakt API Key Rewrite
# 统一拦截 Trakt 响应，由脚本内部分流处理
http-response ^https:\/\/apiz?\.trakt\.tv\/.*$ script-path=https://raw.githubusercontent.com/lucere30/trakt-enhance/main/trakt_simplified_chinese/trakt_simplified_chinese.js, requires-body=true, timeout=60, argument=[{fakeVipEnabled},{chineseLocale},{posterImageMode},{translationEngine},{characterTranslationEnabled},{historyEpisodesMergedByShow},{eplayerxButtonOrder},{forwardButtonOrder},{infuseButtonOrder},{rexButtonOrder},{backendBaseUrl},{tamperAppAuthorizationEnabled},{debugMode},{chineseOnlyTranslation},{peopleTranslationEnabled},{personSearchTranslationMode},{chinesePosterEnabled}], tag=Trakt Response Router
# 仅拦截 SofaTime 的 TMDB provider 列表，注入播放器
http-response ^https:\/\/api\.themoviedb\.org\/3\/watch\/providers\/(?:movie|tv)(\?.*)?$ script-path=https://raw.githubusercontent.com/lucere30/trakt-enhance/main/trakt_simplified_chinese/trakt_simplified_chinese.js, requires-body=true, timeout=60, argument=[{fakeVipEnabled},{chineseLocale},{posterImageMode},{translationEngine},{characterTranslationEnabled},{historyEpisodesMergedByShow},{eplayerxButtonOrder},{forwardButtonOrder},{infuseButtonOrder},{rexButtonOrder},{backendBaseUrl},{tamperAppAuthorizationEnabled},{debugMode},{chineseOnlyTranslation},{peopleTranslationEnabled},{personSearchTranslationMode},{chinesePosterEnabled}], tag=TMDB Provider Catalog
# 仅拦截 SofaTime 的 TMDB 详情请求（append_to_response 含 watch/providers），清除原有观看来源并注入排序 1 播放器
http-response ^https:\/\/api\.themoviedb\.org\/3\/(?:tv|movie)\/\d+\?.*watch(?:%2F|\/)providers.*$ script-path=https://raw.githubusercontent.com/lucere30/trakt-enhance/main/trakt_simplified_chinese/trakt_simplified_chinese.js, requires-body=true, timeout=60, argument=[{fakeVipEnabled},{chineseLocale},{posterImageMode},{translationEngine},{characterTranslationEnabled},{historyEpisodesMergedByShow},{eplayerxButtonOrder},{forwardButtonOrder},{infuseButtonOrder},{rexButtonOrder},{backendBaseUrl},{tamperAppAuthorizationEnabled},{debugMode},{chineseOnlyTranslation},{peopleTranslationEnabled},{personSearchTranslationMode},{chinesePosterEnabled}], tag=TMDB Detail Watch Providers

[MITM]
hostname = apiz.trakt.tv, api.trakt.tv, auth.trakt.tv, trakt.tv, api.themoviedb.org, image.tmdb.org, loon-plugins.demojameson.de5.net
