+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { isChineseLanguage } from "../trakt_simplified_chinese/src/shared/translation-scope.mjs";
+
+import { TEST_TMDB_API_KEY } from "./helpers/run-script.mjs";
+import {
+    createMediaTranslationCache,
+    createMediaTranslationEntry,
+    createPeopleTranslationCache,
+    createTmdbImagesResponse,
+    createUnifiedPersistentData,
+    parseUnifiedCache,
+    readFixture,
+    runResponseCase,
+} from "./helpers/trakt-test-helpers.mjs";
+
+const LANGUAGE_STORE_KEY = "dj_trakt_fork_media_language";
+const ON = { chineseOnlyTranslation: true };
+
+function createPersistentData(translations = {}, languages = null) {
+    const data = createUnifiedPersistentData({
+        traktTranslation: JSON.parse(createMediaTranslationCache(translations)),
+    });
+    if (languages) {
+        data[LANGUAGE_STORE_KEY] = JSON.stringify(languages);
+    }
+    return data;
+}
+
+function readLanguageStore(persistentData) {
+    return JSON.parse(String(persistentData?.[LANGUAGE_STORE_KEY] ?? "{}"));
+}
+
+const COMMENT_STORE_KEY = "dj_trakt_fork_comment_scope";
+
+function readCommentStore(persistentData) {
+    return JSON.parse(String(persistentData?.[COMMENT_STORE_KEY] ?? "{}"));
+}
+
+function hasTranslationRequest(httpLogs) {
+    return httpLogs.some((log) => /\/translations\/zh|\/v3\/intl\/bulk|translate|deepl/.test(log.url));
+}
+
+// passThrough 时脚本不改写响应，runScript 拿到的 body 为 undefined
+function assertPassThrough(result) {
+    assert.equal(result.body, undefined);
+}
+
+test("isChineseLanguage 只把中文当作中文原片，未知返回 null", () => {
+    assert.equal(isChineseLanguage("zh"), true);
+    assert.equal(isChineseLanguage("cn"), true);
+    assert.equal(isChineseLanguage("zh-TW"), true);
+    assert.equal(isChineseLanguage("en"), false);
+    assert.equal(isChineseLanguage("ja"), false);
+    assert.equal(isChineseLanguage(""), null);
+    assert.equal(isChineseLanguage(null), null);
+});
+
+test("英语电影详情原样放行，不请求翻译，并记住语言", async () => {
+    const detail = { ...JSON.parse(readFixture("movie-detail.json")), language: "en" };
+    const { result, httpLogs, persistentData } = await runResponseCase({
+        url: "https://api.trakt.tv/movies/123",
+        body: JSON.stringify(detail),
+        argument: ON,
+        persistentData: createPersistentData({ "movie:123": createMediaTranslationEntry({ translation: { title: "中文标题", overview: "中文简介" } }) }),
+    });
+
+    assertPassThrough(result);
+    assert.equal(hasTranslationRequest(httpLogs), false);
+    assert.equal(readLanguageStore(persistentData)["movie:123"], "en");
+});
+
+test("中文电影详情照常应用中文翻译", async () => {
+    const detail = { ...JSON.parse(readFixture("movie-detail.json")), language: "zh" };
+    const { result } = await runResponseCase({
+        url: "https://api.trakt.tv/movies/123",
+        body: JSON.stringify(detail),
+        argument: ON,
+        persistentData: createPersistentData({
+            "movie:123": createMediaTranslationEntry({ translation: { title: "中文标题", overview: "中文简介", tagline: "中文标语" } }),
+        }),
+    });
+
+    const payload = JSON.parse(result.body);
+    assert.equal(payload.title, "中文标题");
+    assert.equal(payload.overview, "中文简介");
+});
+
+function createWatchlistItems() {
+    return [
+        { type: "show", show: { title: "English Show", language: "en", ids: { trakt: 11 }, images: { poster: ["trakt/english.jpg"] } } },
+        { type: "show", show: { title: "Chinese Show", language: "zh", ids: { trakt: 22 } } },
+        { type: "show", show: { title: "Japanese Show", language: "ja", ids: { trakt: 33 } } },
+        {
+            type: "episode",
+            show: { title: "English Show", language: "en", ids: { trakt: 11 } },
+            episode: { season: 1, number: 3, title: "Episode 3", ids: { trakt: 1103 } },
+        },
+    ];
+}
+
+const WATCHLIST_TRANSLATIONS = {
+    "show:11": createMediaTranslationEntry({ translation: { title: "英语剧中文名" } }),
+    "show:22": createMediaTranslationEntry({ translation: { title: "中文剧中文名" } }),
+    "show:33": createMediaTranslationEntry({ translation: { title: "日剧中文名" } }),
+    "episode:11:1:3": createMediaTranslationEntry({ translation: { title: "英语剧第三集" } }),
+};
+
+test("列表里只翻译中文剧集，其他语言条目（无 TMDb 海报可换时）与 Trakt 返回完全一致", async () => {
+    const items = createWatchlistItems();
+    const { result } = await runResponseCase({
+        url: "https://api.trakt.tv/users/me/watchlist",
+        body: JSON.stringify(items),
+        argument: { ...ON, posterImageMode: "chinese" },
+        persistentData: createPersistentData(WATCHLIST_TRANSLATIONS),
+    });
+
+    const payload = JSON.parse(result.body);
+    assert.equal(payload[1].show.title, "中文剧中文名");
+    assert.deepEqual(payload[0], items[0]);
+    assert.deepEqual(payload[2], items[2]);
+    assert.deepEqual(payload[3], items[3]);
+});
+
+test("关闭“只翻译中文影视”时与上游一致，所有条目都翻译", async () => {
+    const { result } = await runResponseCase({
+        url: "https://api.trakt.tv/users/me/watchlist",
+        body: JSON.stringify(createWatchlistItems()),
+        argument: { chineseOnlyTranslation: false },
+        persistentData: createPersistentData(WATCHLIST_TRANSLATIONS),
+    });
+
+    const payload = JSON.parse(result.body);
+    assert.equal(payload[0].show.title, "英语剧中文名");
+    assert.equal(payload[2].show.title, "日剧中文名");
+    assert.equal(payload[3].episode.title, "英语剧第三集");
+});
+
+test("列表条目没有 language 时补查一次剧集详情，并记住语言供下次使用", async () => {
+    const body = JSON.stringify([{ type: "show", show: { title: "Unknown Show", ids: { trakt: 44 } } }]);
+    const detailUrl = "https://api.trakt.tv/shows/44?extended=cloud9,full,watchnow";
+    const { result, httpLogs, persistentData } = await runResponseCase({
+        url: "https://api.trakt.tv/users/me/watchlist",
+        body,
+        argument: ON,
+        httpGetMocks: { [detailUrl]: JSON.stringify({ title: "Unknown Show", language: "en", ids: { trakt: 44, slug: "unknown-show" } }) },
+        persistentData: createPersistentData({ "show:44": createMediaTranslationEntry({ translation: { title: "未知剧中文名" } }) }),
+    });
+
+    assert.equal(JSON.parse(result.body)[0].show.title, "Unknown Show");
+    assert.equal(httpLogs.filter((log) => log.url === detailUrl).length, 1);
+    assert.equal(readLanguageStore(persistentData)["show:44"], "en");
+    assert.equal(readLanguageStore(persistentData)["show:unknown-show"], "en");
+
+    const second = await runResponseCase({
+        url: "https://api.trakt.tv/users/me/watchlist",
+        body,
+        argument: ON,
+        persistentData,
+    });
+    assert.equal(JSON.parse(second.result.body)[0].show.title, "Unknown Show");
+    assert.equal(second.httpLogs.filter((log) => log.url === detailUrl).length, 0);
+});
+
+test("补查详情失败、语言仍未知时按中文处理，不漏翻中文剧集", async () => {
+    const { result } = await runResponseCase({
+        url: "https://api.trakt.tv/users/me/watchlist",
+        body: JSON.stringify([{ type: "show", show: { title: "Unknown Show", ids: { trakt: 55 } } }]),
+        argument: ON,
+        httpGetMocks: { "https://api.trakt.tv/shows/55?extended=cloud9,full,watchnow": { status: 500, body: "{}" } },
+        persistentData: createPersistentData({ "show:55": createMediaTranslationEntry({ translation: { title: "未知剧中文名" } }) }),
+    });
