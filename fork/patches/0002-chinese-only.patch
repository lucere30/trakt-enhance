new file mode 100644
index 0000000..513d1f8
--- /dev/null
+++ b/trakt_simplified_chinese/src/features/people-search-scope.mjs
@@ -0,0 +1,265 @@
+//「人物搜索翻译」（只翻译中文影视开启时生效）分四档：全部翻译 / 华人和日韩名 / 仅华人名 / 关闭。
+//    - 华人和日韩名：TMDb 有中文名，且中文名不含间隔号（音译的外国名一般写成「汤姆·汉克斯」）。
+//    - 仅华人名：在上一档基础上，再排除 TMDb 出生地在日本、韩国的人；出生地缺失或在其他地方（含海外华裔）按华人处理。
+//    - 中文名优先取本地缓存和翻译缓存后端；都没有时补查一次 TMDb 人物详情（每页最多 MAX_TMDB_LOOKUPS 个），
+//      结果写回人物缓存（有中文名 90 天、无中文名 7 天），出生地判定单独长期记在本地，同一个人只查一次。
+//    - 不符合条件的人原样保留，名字和简介都不调用机器翻译。
+// 关闭档在 translation-scope 的 shouldBypassResponse 里直接放行。
+import * as tmdbClientModule from "../outbound/tmdb-client.mjs";
+import * as cacheUtils from "../utils/cache.mjs";
+import * as commonUtils from "../utils/common.mjs";
+
+import {
+    applyPersonNameNotFoundCache,
+    flushPeopleNameBackendWrites,
+    getCachedTmdbPersonNameTranslation,
+    getPeopleTranslationCacheEntry,
+    getValidPersonNameNotFoundEntry,
+    hydratePeopleNamesFromBackend,
+    PEOPLE_NAME_SOURCE,
+    setPeopleTranslationCacheEntry,
+} from "./people-name-cache.mjs";
+import { handlePeopleSearchList } from "./people-translation.mjs";
+import { collectPeopleCollectionItems } from "./people-translation-apply.mjs";
+
+const PERSON_SEARCH_MODE = {
+    ALL: "all",
+    EAST_ASIAN: "eastAsian",
+    CHINESE: "chinese",
+    OFF: "off",
+};
+const PERSON_SEARCH_MODE_LABELS = {
+    全部翻译: PERSON_SEARCH_MODE.ALL,
+    华人和日韩名: PERSON_SEARCH_MODE.EAST_ASIAN,
+    仅华人名: PERSON_SEARCH_MODE.CHINESE,
+    关闭: PERSON_SEARCH_MODE.OFF,
+};
+
+const REGION_STORE_KEY = "dj_trakt_fork_person_region";
+const REGION_STORE_MAX_ENTRIES = 3000;
+const REGION = { CHINESE: "c", JAPAN_KOREA: "jk" };
+const MAX_TMDB_LOOKUPS = 20;
+
+// 间隔号的几种写法：· • ・ ‧ ･ ‐（音译外国名用来分隔名和姓）
+const NAME_SEPARATOR_RE = /[·•・‧･‐]/;
+// 出生地文本大多是英文（"Tokyo, Japan"），也有中文的（"臺灣屏東縣潮州鎮"）
+const JAPAN_KOREA_BIRTHPLACE_RE = /japan|korea|日本|韩国|韓國|大韩|大韓|朝鲜|朝鮮/i;
+
+function normalizePersonSearchMode(value) {
+    const normalized = String(value ?? "").trim();
+    if (PERSON_SEARCH_MODE_LABELS[normalized]) {
+        return PERSON_SEARCH_MODE_LABELS[normalized];
+    }
+    return Object.values(PERSON_SEARCH_MODE).includes(normalized) ? normalized : PERSON_SEARCH_MODE.ALL;
+}
+
+function getPersonSearchMode() {
+    return normalizePersonSearchMode(globalThis.$ctx?.argument?.personSearchTranslationMode);
+}
+
+function isEastAsianName(chineseName) {
+    const name = String(chineseName ?? "").trim();
+    return !!name && commonUtils.containsChineseCharacter(name) && !NAME_SEPARATOR_RE.test(name);
+}
+
+function resolveRegionFromBirthplace(placeOfBirth) {
+    return JAPAN_KOREA_BIRTHPLACE_RE.test(String(placeOfBirth ?? "")) ? REGION.JAPAN_KOREA : REGION.CHINESE;
+}
+
+// ---------- 本地记录（出生地判定，按写入先后淘汰最旧的） ----------
+
+const STORES = {
+    region: { key: REGION_STORE_KEY, max: REGION_STORE_MAX_ENTRIES },
+};
+
+function getStoreState(name) {
+    const context = globalThis.$ctx;
+    if (!context) {
+        return { store: {}, dirty: false };
+    }
+    context.__personSearchStores ||= {};
+    if (!context.__personSearchStores[name]) {
+        let store = {};
+        try {
+            store = commonUtils.ensureObject(context.env?.getjson(STORES[name].key, {}));
+        } catch {
+            store = {};
+        }
+        context.__personSearchStores[name] = { store, dirty: false };
+    }
+    return context.__personSearchStores[name];
+}
+
+function readStoreEntry(name, key) {
+    return key ? (getStoreState(name).store[key] ?? "") : "";
+}
+
+function writeStoreEntry(name, key, value) {
+    if (!key || !value) {
+        return;
+    }
+    const state = getStoreState(name);
+    if (state.store[key] === value) {
+        return;
+    }
+    delete state.store[key];
+    state.store[key] = value;
+    state.dirty = true;
+}
+
+function flushStore(name) {
+    const state = getStoreState(name);
+    if (!state.dirty) {
+        return;
+    }
+    const keys = Object.keys(state.store);
+    if (keys.length > STORES[name].max) {
+        keys.slice(0, keys.length - STORES[name].max).forEach((key) => {
+            delete state.store[key];
+        });
+    }
+    try {
+        globalThis.$ctx?.env?.setjson(state.store, STORES[name].key);
+        state.dirty = false;
+    } catch (error) {
+        globalThis.$ctx?.env?.log?.(`Trakt person search ${name} store save failed: ${error}`);
+    }
+}
+
+// ---------- 人物搜索：只翻译华人（和日韩）名 ----------
+
+function describePerson(person, cache) {
+    const traktId = commonUtils.isNonNullish(person?.ids?.trakt) ? String(person.ids.trakt) : "";
+    const tmdbId = person?.ids?.tmdb;
+    const originalName = String(person?.name ?? "").trim();
+    const entry = traktId ? getPeopleTranslationCacheEntry(cache, traktId) : null;
+    return {
+        person,
+        traktId,
+        tmdbId,
+        originalName,
+        chineseName: entry && originalName ? getCachedTmdbPersonNameTranslation(entry, originalName) : "",
+        hasNotFound: !!getValidPersonNameNotFoundEntry(entry),
+    };
+}
+
+function needsTmdbName(info) {
+    return !!info.traktId && !!info.originalName && commonUtils.isNonNullish(info.tmdbId) && !info.chineseName && !info.hasNotFound;
+}
+
+function needsRegion(info, mode) {
+    return mode === PERSON_SEARCH_MODE.CHINESE && isEastAsianName(info.chineseName) && !readStoreEntry("region", info.traktId);
+}
+
+// 补查 TMDb 人物详情：拿中文名（写回人物缓存）和出生地（写进出生地记录）
+async function lookupTmdbPeople(infos, cache) {
+    let cacheChanged = false;
+    await Promise.all(
+        infos.map(async (info) => {
+            try {
+                const payload = await tmdbClientModule.fetchPerson(info.tmdbId);
+                const chineseName = String(payload?.name ?? "").trim();
+                if (chineseName && commonUtils.containsChineseCharacter(chineseName)) {
+                    cacheChanged =
+                        setPeopleTranslationCacheEntry(
+                            cache,
+                            info.traktId,
+                            {
+                                name: {
+                                    sourceTextHash: commonUtils.computeStringHash(info.originalName),
+                                    translatedText: chineseName,
+                                    source: PEOPLE_NAME_SOURCE.TMDB,
+                                },
+                            },
+                            true,
+                        ) || cacheChanged;
+                    info.chineseName = chineseName;
+                } else {
+                    cacheChanged = applyPersonNameNotFoundCache(cache, info.traktId) || cacheChanged;
+                    info.hasNotFound = true;
+                }
+                writeStoreEntry("region", info.traktId, resolveRegionFromBirthplace(payload?.place_of_birth));
+            } catch (error) {
+                globalThis.$ctx?.env?.log?.(`Trakt person search TMDb lookup failed for ${info.traktId}: ${error}`);
+            }
+        }),
+    );
+    return cacheChanged;
+}
+
+function isPersonInScope(info, mode) {
+    if (!isEastAsianName(info.chineseName)) {
+        return false;
+    }
+    if (mode !== PERSON_SEARCH_MODE.CHINESE) {
+        return true;
+    }
+    // 补查失败、还不知道出生地的，这次先按华人处理（名字已经通过了无间隔号的检查）
+    return readStoreEntry("region", info.traktId) !== REGION.JAPAN_KOREA;
+}
+
+// 交给上游的人物搜索翻译处理：只把符合条件的人传过去，翻译完放回原位置，其他人原样保留
+async function translateSelectedEntries(data, selectedIndexes) {
+    if (selectedIndexes.length === 0) {
+        return { type: "respond", body: JSON.stringify(data) };
+    }
+    const context = globalThis.$ctx;
+    const originalBody = context.responseBody;
+    try {
+        context.responseBody = JSON.stringify(selectedIndexes.map((index) => data[index]));
+        const result = await handlePeopleSearchList();
+        const translated = result?.type === "respond" ? commonUtils.parseJsonBody(result.body) : null;
+        if (Array.isArray(translated) && translated.length === selectedIndexes.length) {
+            selectedIndexes.forEach((dataIndex, index) => {
+                data[dataIndex] = translated[index];
+            });
+        }
+    } finally {
+        context.responseBody = originalBody;
+    }
+    return { type: "respond", body: JSON.stringify(data) };
+}
+
+async function handleScopedPeopleSearchList() {
+    const mode = getPersonSearchMode();
+    const context = globalThis.$ctx;
+    if (context?.argument?.chineseOnlyTranslation === false || mode === PERSON_SEARCH_MODE.ALL || mode === PERSON_SEARCH_MODE.OFF) {
+        // 关闭档已在响应入口放行，这里只会遇到全部翻译
+        return handlePeopleSearchList();
+    }
+
+    const data = commonUtils.parseJsonBody(context.responseBody);
+    if (!Array.isArray(data)) {
+        return { type: "passThrough" };
+    }
+
+    const cache = cacheUtils.loadPeopleTranslationCache(context.env);
+    let cacheChanged = false;
+    let infos = data.map((entry) => {
+        const person = collectPeopleCollectionItems([entry])[0]?.person;
+        return person ? describePerson(person, cache) : null;
+    });
+
+    // 先问翻译缓存后端（一次批量请求），后端也没有的再逐个查 TMDb
+    const backendIds = infos.filter((info) => info && needsTmdbName(info)).map((info) => info.traktId);
+    if (backendIds.length > 0) {
+        cacheChanged = (await hydratePeopleNamesFromBackend(cache, backendIds)) || cacheChanged;
+        infos = infos.map((info) => (info ? describePerson(info.person, cache) : null));
+    }
+
+    const lookups = infos.filter((info) => info && (needsTmdbName(info) || needsRegion(info, mode))).slice(0, MAX_TMDB_LOOKUPS);
+    if (lookups.length > 0) {
+        cacheChanged = (await lookupTmdbPeople(lookups, cache)) || cacheChanged;
+    }
+
+    if (cacheChanged) {
+        cacheUtils.savePeopleTranslationCache(context.env, cache);
+    }
+    flushPeopleNameBackendWrites();
+    flushStore("region");
+
+    const selectedIndexes = infos.reduce((indexes, info, index) => (info && isPersonInScope(info, mode) ? indexes.concat(index) : indexes), []);
+    return translateSelectedEntries(data, selectedIndexes);
+}
+
+export { getPersonSearchMode, handleScopedPeopleSearchList, isEastAsianName, normalizePersonSearchMode, PERSON_SEARCH_MODE, resolveRegionFromBirthplace };
