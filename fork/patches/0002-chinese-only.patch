diff --git a/trakt_simplified_chinese/src/shared/translation-scope.mjs b/trakt_simplified_chinese/src/shared/translation-scope.mjs
new file mode 100644
index 0000000..ab7851a
--- /dev/null
+++ b/trakt_simplified_chinese/src/shared/translation-scope.mjs
@@ -0,0 +1,403 @@
+// 只翻译中文影视：原始语言为中文的剧集/电影照常翻译；其他语言的文字内容保留 Trakt 原文，不做翻译。
+// 海报：「中文影视用中文原海报」开启时中文影视按原片语言取海报，其他影视按「海报语言」（见 getChinesePosterMode）。
+//
+// - 列表：逐条判断，只有中文条目的文字会被翻译。
+// - 绑定到单个影视的页面：详情、季列表只替换海报不动文字；预告片、评论、口碑摘要、演职员表对非中文影视原样放行。
+// - 人物页：由「人物页翻译」开关决定；人物搜索（含本月生日人物列表）：由「人物搜索翻译」决定（四档，关闭档在这里放行，
+//   只翻译华人/日韩名两档见 features/people-search-scope.mjs）。
+// - 片单名称和描述：不属于某个影视，不处理。
+// - 非翻译功能（播放器跳转按钮、VIP、历史合并等）不受影响。
+//
+// 原始语言取自 Trakt 返回的 language 字段；见过的语言按 show/movie + traktId（和 slug）记录在本地，
+// 响应里没有语言时从记录里取，仍未知时请求一次详情；实在拿不到时按“中文”处理，避免漏翻中文剧集。
+import { getPersonSearchMode, PERSON_SEARCH_MODE } from "../features/people-search-scope.mjs";
+import * as traktApiClient from "../outbound/trakt-api-client.mjs";
+import * as commonUtils from "../utils/common.mjs";
+
+import * as mediaTypes from "./media-types.mjs";
+
+const CHINESE_LANGUAGES = new Set(["zh", "cn"]);
+const LANGUAGE_STORE_KEY = "dj_trakt_fork_media_language";
+const LANGUAGE_STORE_MAX_ENTRIES = 3000;
+// 评论记录单独存放：一页评论可能有上百条，和语言记录放在一起会把语言记录挤掉
+const COMMENT_STORE_KEY = "dj_trakt_fork_comment_scope";
+const COMMENT_STORE_MAX_ENTRIES = 3000;
+const LEGACY_COMMENT_KEY_PREFIX = "comment:";
+const LANGUAGE_FETCH_LIMIT = 10;
+const OUT_OF_SCOPE_MARK = "-";
+
+function isChineseOnlyEnabled() {
+    return globalThis.$ctx?.argument?.chineseOnlyTranslation !== false;
+}
+
+function isChinesePosterEnabled() {
+    return globalThis.$ctx?.argument?.chinesePosterEnabled === true;
+}
+
+// 「中文影视用中文原海报」需要事先知道语言：「海报语言」本身是原片语言时结果相同，不必额外查询
+function needsLanguageForPoster() {
+    return isChinesePosterEnabled() && globalThis.$ctx?.argument?.posterImageMode !== "original";
+}
+
+function normalizeLanguage(value) {
+    const normalized = String(value ?? "")
+        .trim()
+        .toLowerCase()
+        .replace(/_/g, "-")
+        .split("-")[0];
+    return /^[a-z]{2,3}$/.test(normalized) ? normalized : "";
+}
+
+// true：中文原片；false：其他语言；null：未知
+function isChineseLanguage(language) {
+    const normalized = normalizeLanguage(language);
+    return normalized ? CHINESE_LANGUAGES.has(normalized) : null;
+}
+
+// ---------- 本地记录（语言、评论各一份，按写入先后淘汰最旧的） ----------
+
+const STORES = {
+    language: { key: LANGUAGE_STORE_KEY, max: LANGUAGE_STORE_MAX_ENTRIES },
+    comment: { key: COMMENT_STORE_KEY, max: COMMENT_STORE_MAX_ENTRIES },
+};
+
+function getStoreState(name) {
+    const context = globalThis.$ctx;
+    if (!context) {
+        return { store: {}, dirty: false };
+    }
+    context.__translationScopeStores ||= {};
+    if (!context.__translationScopeStores[name]) {
+        let store = {};
+        try {
+            store = commonUtils.ensureObject(context.env?.getjson(STORES[name].key, {}));
+        } catch {
+            store = {};
+        }
+        const state = { store, dirty: false };
+        if (name === "language") {
+            // 旧版本把评论记录也放在语言记录里，读到时清掉
+            Object.keys(store)
+                .filter((key) => key.startsWith(LEGACY_COMMENT_KEY_PREFIX))
+                .forEach((key) => {
+                    delete store[key];
+                    state.dirty = true;
+                });
+        }
+        context.__translationScopeStores[name] = state;
+    }
+    return context.__translationScopeStores[name];
+}
+
+function getLanguageState() {
+    return getStoreState("language");
+}
+
+function writeStoreEntry(key, value, name = "language") {
+    if (!key || !value) {
+        return;
+    }
+    const state = getStoreState(name);
+    if (state.store[key] === value) {
+        return;
+    }
+    delete state.store[key];
+    state.store[key] = value;
+    state.dirty = true;
+}
+
+function flushStore(name) {
+    const state = getStoreState(name);
+    if (!state.dirty) {
+        return;
+    }
+    const keys = Object.keys(state.store);
+    if (keys.length > STORES[name].max) {
+        keys.slice(0, keys.length - STORES[name].max).forEach((key) => {
+            delete state.store[key];
+        });
+    }
+    try {
+        globalThis.$ctx?.env?.setjson(state.store, STORES[name].key);
+        state.dirty = false;
+    } catch (error) {
+        globalThis.$ctx?.env?.log?.(`Trakt chinese-only ${name} store save failed: ${error}`);
+    }
+}
+
+function flushLanguageStore() {
+    flushStore("language");
+    flushStore("comment");
+}
+
+function buildMediaKey(mediaType, idOrSlug) {
+    if (commonUtils.isNullish(idOrSlug) || String(idOrSlug) === "" || (mediaType !== mediaTypes.MEDIA_TYPE.SHOW && mediaType !== mediaTypes.MEDIA_TYPE.MOVIE)) {
+        return "";
+    }
+    return `${mediaType}:${String(idOrSlug).toLowerCase()}`;
+}
+
+function rememberMediaLanguage(mediaType, media, language = media?.language) {
+    const normalized = normalizeLanguage(language);
+    if (!normalized) {
+        return;
+    }
+    writeStoreEntry(buildMediaKey(mediaType, media?.ids?.trakt), normalized);
+    writeStoreEntry(buildMediaKey(mediaType, media?.ids?.slug), normalized);
+}
+
+function recallMediaLanguage(mediaType, idOrSlug) {
+    const key = buildMediaKey(mediaType, idOrSlug);
+    return key ? (getLanguageState().store[key] ?? "") : "";
+}
+
+async function fetchMediaLanguage(mediaType, idOrSlug) {
+    try {
+        const detail = await traktApiClient.fetchMediaDetail(mediaType, idOrSlug);
+        const language = normalizeLanguage(detail?.language);
+        if (language) {
+            writeStoreEntry(buildMediaKey(mediaType, idOrSlug), language);
+            rememberMediaLanguage(mediaType, detail, language);
+        }
+        return language;
+    } catch (error) {
+        globalThis.$ctx?.env?.log?.(`Trakt chinese-only language lookup failed for ${mediaType}:${idOrSlug}: ${error}`);
+        return "";
+    }
+}
+
+async function resolveMediaLanguage(mediaType, idOrSlug, knownLanguage = null) {
+    const known = normalizeLanguage(knownLanguage);
+    if (known) {
+        writeStoreEntry(buildMediaKey(mediaType, idOrSlug), known);
+        return known;
+    }
+    const recalled = recallMediaLanguage(mediaType, idOrSlug);
+    if (recalled || !buildMediaKey(mediaType, idOrSlug)) {
+        return recalled;
+    }
+    return fetchMediaLanguage(mediaType, idOrSlug);
+}
+
+// 单个影视是否需要处理（未知语言按需要处理）
+async function isMediaInScope(mediaType, idOrSlug, knownLanguage = null) {
+    if (!isChineseOnlyEnabled()) {
+        return true;
+    }
+    const language = await resolveMediaLanguage(mediaType, idOrSlug, knownLanguage);
+    flushLanguageStore();
+    return isChineseLanguage(language) !== false;
+}
+
+// ---------- 列表 ----------
+
+// 列表条目的语言来源：电影看自身，剧集/季/单集看所属剧集
+function getItemLanguageSource(item) {
+    if (!commonUtils.isPlainObject(item)) {
+        return null;
+    }
+    if (commonUtils.isPlainObject(item.movie)) {
+        return { mediaType: mediaTypes.MEDIA_TYPE.MOVIE, media: item.movie };
+    }
+    if (commonUtils.isPlainObject(item.show)) {
+        return { mediaType: mediaTypes.MEDIA_TYPE.SHOW, media: item.show };
+    }
+    return null;
+}
+
+function getSourceLanguage(source) {
+    return (
+        normalizeLanguage(source.media?.language) ||
+        recallMediaLanguage(source.mediaType, source.media?.ids?.trakt) ||
+        recallMediaLanguage(source.mediaType, source.media?.ids?.slug)
+    );
+}
+
+// 返回需要翻译文字的条目（中文或语言未知）；其他条目的文字调用方不应触碰
+async function filterItemsInScope(items) {
+    if (commonUtils.isNotArray(items) || (!isChineseOnlyEnabled() && !needsLanguageForPoster())) {
+        return items;
+    }
+
+    const sources = items.map((item) => {
+        const source = getItemLanguageSource(item);
+        if (source) {
+            rememberMediaLanguage(source.mediaType, source.media);
+        }
+        return source;
+    });
+
+    const unknown = new Map();
+    sources.forEach((source) => {
+        const id = source?.media?.ids?.trakt;
+        const key = buildMediaKey(source?.mediaType, id);
+        if (key && !getSourceLanguage(source)) {
+            unknown.set(key, source);
+        }
+    });
+    await Promise.all(
+        Array.from(unknown.values())
+            .slice(0, LANGUAGE_FETCH_LIMIT)
+            .map((source) => fetchMediaLanguage(source.mediaType, source.media.ids.trakt)),
+    );
+    flushLanguageStore();
+
+    if (!isChineseOnlyEnabled()) {
+        return items;
+    }
+    return items.filter((item, index) => {
+        const source = sources[index];
+        return !source || isChineseLanguage(getSourceLanguage(source)) !== false;
+    });
+}
+
+// ---------- 海报 ----------
+
+// 「中文影视用中文原海报」：中文影视返回 "original"（原片语言 = 中文，优先原产地区版本）；否则 null，由调用方用「海报语言」
+// 只读已知语言（响应自带或本地记录），不发请求；语言未知时按「海报语言」处理
+function getChinesePosterMode(mediaType, media, knownLanguage = null) {
+    if (!isChinesePosterEnabled()) {
+        return null;
+    }
+    const ids = commonUtils.isPlainObject(media) ? media.ids : null;
+    const language =
+        normalizeLanguage(knownLanguage) ||
+        normalizeLanguage(commonUtils.isPlainObject(media) ? media.language : null) ||
+        recallMediaLanguage(mediaType, ids ? ids.trakt : media) ||
+        (ids ? recallMediaLanguage(mediaType, ids.slug) : "");
+    return isChineseLanguage(language) === true ? "original" : null;
+}
+
+// 季列表等只有剧集 ID 的场景：本地没有语言记录时补查一次（仅在需要时）
+async function resolveChinesePosterMode(mediaType, idOrSlug, knownLanguage = null) {
+    if (!isChinesePosterEnabled()) {
+        return null;
+    }
+    const language = needsLanguageForPoster()
+        ? await resolveMediaLanguage(mediaType, idOrSlug, knownLanguage)
+        : normalizeLanguage(knownLanguage) || recallMediaLanguage(mediaType, idOrSlug);
+    flushLanguageStore();
+    return isChineseLanguage(language) === true ? "original" : null;
+}
+
+// ---------- 评论 ----------
+
+function collectCommentIds(body) {
+    return commonUtils
+        .ensureArray(body)
+        .map((entry) => (commonUtils.isPlainObject(entry?.comment) ? entry.comment : entry))
+        .map((comment) => comment?.id)
+        .filter((id) => commonUtils.isNonNullish(id));
+}
+
+function markCommentsOutOfScope(commentIds) {
+    commentIds.forEach((id) => writeStoreEntry(String(id), OUT_OF_SCOPE_MARK, "comment"));
+}
+
+function isCommentOutOfScope(commentId) {
+    return getStoreState("comment").store[String(commentId)] === OUT_OF_SCOPE_MARK;
+}
+
+// ---------- 响应阶段放行 ----------
+
+const MEDIA_BOUND_ROUTES = [
+    // 评论
+    { pattern: /^(movies|shows)\/([^/]+)\/comments\/[^/]+$/i, comments: true },
+    { pattern: /^(shows)\/([^/]+)\/seasons\/\d+(?:\/episodes\/\d+)?\/comments\/[^/]+$/i, comments: true },
+    // 口碑摘要
+    { pattern: /^(shows|movies)\/(\d+)\/sentiments$/i },
+    { pattern: /^(?:v3\/)?media\/(movie|show)\/(\d+)\/info\/\d+\/version\/\d+$/i },
+    // 演职员表
+    { pattern: /^(movies|shows)\/([^/]+)\/people$/i },
+    { pattern: /^(shows)\/([^/]+)\/seasons\/\d+(?:\/episodes\/\d+)?\/people$/i },
+    // 预告片
+    { pattern: /^(movies|shows)\/(\d+)\/videos$/i },
+];
+
+// 人物页：由「人物页翻译」开关决定
+// 人物页（「人物页翻译」）和人物搜索/人物列表（「人物搜索翻译」）各由一个开关决定
+const PERSON_PAGE_ROUTES = [/^people\/(?!this_month$)[a-z0-9-]+$/i];
+const PERSON_SEARCH_ROUTES = [/^search\/person$/i, /^people\/this_month$/i];
+
+// 片单名称和描述：不属于某个影视，不处理
+const UNBOUND_ROUTES = [
+    /^(movies|shows)\/[^/]+\/lists\/[^/]+(\/[^/]+)?$/i,
+    /^users\/[^/]+\/likes\/lists$/i,
+    /^users\/[^/]+\/lists\/collaborations$/i,
+    /^users\/[^/]+\/lists$/i,
+    /^search\/list$/i,
+    /^lists\/(trending|popular)$/i,
+];
+
+function toMediaType(value) {
+    return /^movies?$/i.test(value) ? mediaTypes.MEDIA_TYPE.MOVIE : mediaTypes.MEDIA_TYPE.SHOW;
+}
+
+function isTraktApiHost(context) {
+    return /^apiz?\.trakt\.tv$/i.test(String(context?.url?.hostname ?? ""));
+}
+
+// 响应阶段：返回 true 表示原样放行，不交给后续处理
+async function shouldBypassResponse(context) {
+    if (!isChineseOnlyEnabled() || !isTraktApiHost(context)) {
+        return false;
+    }
+    const path = String(context.url.shortPathname ?? "");
+
+    if (UNBOUND_ROUTES.some((pattern) => pattern.test(path))) {
+        return true;
+    }
+
+    if (PERSON_SEARCH_ROUTES.some((pattern) => pattern.test(path))) {
+        return getPersonSearchMode() === PERSON_SEARCH_MODE.OFF;
+    }
+
+    if (PERSON_PAGE_ROUTES.some((pattern) => pattern.test(path))) {
+        return globalThis.$ctx?.argument?.peopleTranslationEnabled === false;
+    }
+
+    const commentMatch = path.match(/^comments\/(\d+)(?:\/replies)?$/i);
+    if (commentMatch) {
+        return isCommentOutOfScope(commentMatch[1]);
+    }
+
+    for (const route of MEDIA_BOUND_ROUTES) {
+        const match = path.match(route.pattern);
+        if (!match) {
+            continue;
+        }
+        const inScope = await isMediaInScope(toMediaType(match[1]), match[2]);
+        if (!inScope && route.comments) {
+            // 记住这些评论，之后打开评论详情/回复时同样不翻译
+            markCommentsOutOfScope(collectCommentIds(commonUtils.parseJsonBody(context.responseBody)));
+            flushLanguageStore();
+        }
+        return !inScope;
+    }
+    return false;
+}
+
+// 最近评论列表：只保留中文原片条目交给后续翻译，其他条目的评论记为不处理
+async function filterRecentCommentItems(items) {
+    const inScope = await filterItemsInScope(items);
+    if (inScope === items) {
+        return items;
+    }
+    const inScopeSet = new Set(inScope);
+    markCommentsOutOfScope(collectCommentIds(items.filter((item) => !inScopeSet.has(item))));
+    flushLanguageStore();
+    return inScope;
+}
+
+export {
+    filterItemsInScope,
+    filterRecentCommentItems,
+    getChinesePosterMode,
+    isChineseLanguage,
+    isChineseOnlyEnabled,
+    isChinesePosterEnabled,
+    isMediaInScope,
+    rememberMediaLanguage,
+    resolveChinesePosterMode,
+    shouldBypassResponse,
+};
