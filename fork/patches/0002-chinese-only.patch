+        });
+        assertPassThrough(result);
+        assert.equal(hasTranslationRequest(httpLogs), false, url);
+    }
+});
+
+test("英语影视的评论原样放行，之后打开这些评论的回复也不翻译", async () => {
+    const languages = { "movie:123": "en" };
+    const first = await runResponseCase({
+        url: "https://api.trakt.tv/movies/123/comments/newest",
+        body: readFixture("comments.json"),
+        argument: ON,
+        persistentData: createPersistentData({}, languages),
+    });
+    assertPassThrough(first.result);
+    assert.equal(readCommentStore(first.persistentData)["9001"], "-");
+    // 评论记录和语言记录分开存放，不占语言记录的名额
+    assert.equal(
+        Object.keys(readLanguageStore(first.persistentData)).some((key) => key.startsWith("comment:")),
+        false,
+    );
+
+    const replies = await runResponseCase({
+        url: "https://api.trakt.tv/comments/9001/replies",
+        body: readFixture("comments.json"),
+        argument: ON,
