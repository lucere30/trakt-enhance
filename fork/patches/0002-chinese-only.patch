diff --git a/tests/trakt_people_search_scope.test.mjs b/tests/trakt_people_search_scope.test.mjs
new file mode 100644
index 0000000..5a3b594
--- /dev/null
+++ b/tests/trakt_people_search_scope.test.mjs
@@ -0,0 +1,140 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { isEastAsianName, normalizePersonSearchMode, resolveRegionFromBirthplace } from "../trakt_simplified_chinese/src/features/people-search-scope.mjs";
+
+import { TEST_TMDB_API_KEY } from "./helpers/run-script.mjs";
+import { createUnifiedPersistentData, runResponseCase } from "./helpers/trakt-test-helpers.mjs";
+
+const ON = { chineseOnlyTranslation: true };
+const REGION_STORE_KEY = "dj_trakt_fork_person_region";
+
+// 数据取自 TMDb 实际页面：中文名、出生地写法
+const PEOPLE = {
+    chow: { trakt: 1001, tmdb: 57607, name: "Stephen Chow", zh: "周星驰", birth: "Hong Kong, British Crown Colony [now China]" },
+    wu: { trakt: 1002, tmdb: 64436, name: "Daniel Wu", zh: "吴彦祖", birth: "Berkeley, California, USA" },
+    kimura: { trakt: 1003, tmdb: 12670, name: "Takuya Kimura", zh: "木村拓哉", birth: "Chiba, Chiba, Japan" },
+    song: { trakt: 1004, tmdb: 20738, name: "Song Kang-ho", zh: "宋康昊", birth: "Gimhae, South Gyeongsang, South Korea" },
+    hanks: { trakt: 1005, tmdb: 31, name: "Tom Hanks", zh: "汤姆·汉克斯", birth: "Concord, California, USA" },
+    nobody: { trakt: 1006, tmdb: 999, name: "Some Extra", zh: "", birth: "" },
+};
+
+function personUrl(tmdbId) {
+    return `https://api.tmdb.org/3/person/${tmdbId}?language=zh-CN&api_key=${TEST_TMDB_API_KEY}`;
+}
+
+function createTmdbPersonMocks(keys) {
+    return Object.fromEntries(
+        keys.map((key) => {
+            const p = PEOPLE[key];
+            return [personUrl(p.tmdb), { status: 200, body: JSON.stringify({ id: p.tmdb, name: p.zh || p.name, place_of_birth: p.birth || null }) }];
+        }),
+    );
+}
+
+function createSearchBody(keys) {
+    return JSON.stringify(keys.map((key) => ({ type: "person", score: 1, person: { name: PEOPLE[key].name, ids: { trakt: PEOPLE[key].trakt, tmdb: PEOPLE[key].tmdb } } })));
+}
+
+function namesOf(result) {
+    return JSON.parse(result.body).map((item) => item.person.name);
+}
+
+function isTmdbPersonRequest(log) {
+    return /api\.tmdb\.org\/3\/person\//.test(log.url);
+}
+
+function isMachineTranslationRequest(log) {
+    return /translate|deepl/i.test(log.url);
+}
+
+const ALL_KEYS = ["chow", "wu", "kimura", "song", "hanks", "nobody"];
+
+test("判定规则：中文名不带间隔号才算华人/日韩名；出生地在日本、韩国的算日韩", () => {
+    assert.equal(isEastAsianName("周星驰"), true);
+    assert.equal(isEastAsianName("木村拓哉"), true);
+    assert.equal(isEastAsianName("汤姆·汉克斯"), false);
+    assert.equal(isEastAsianName("汤姆・汉克斯"), false);
+    assert.equal(isEastAsianName("Tom Hanks"), false);
+    assert.equal(isEastAsianName(""), false);
+
+    assert.equal(resolveRegionFromBirthplace("Tokyo, Japan"), "jk");
+    assert.equal(resolveRegionFromBirthplace("Seoul, South Korea"), "jk");
+    assert.equal(resolveRegionFromBirthplace("日本东京"), "jk");
+    assert.equal(resolveRegionFromBirthplace("Hong Kong, British Crown Colony [now China]"), "c");
+    assert.equal(resolveRegionFromBirthplace("臺灣屏東縣潮州鎮"), "c");
+    assert.equal(resolveRegionFromBirthplace("Berkeley, California, USA"), "c");
+    assert.equal(resolveRegionFromBirthplace(null), "c");
+});
+
+test("档位：Loon 传中文选项名、BoxJs 传英文值都能识别，未知值按全部翻译", () => {
+    assert.equal(normalizePersonSearchMode("华人和日韩名"), "eastAsian");
+    assert.equal(normalizePersonSearchMode("仅华人名"), "chinese");
+    assert.equal(normalizePersonSearchMode("关闭"), "off");
+    assert.equal(normalizePersonSearchMode("chinese"), "chinese");
+    assert.equal(normalizePersonSearchMode("xx"), "all");
+    assert.equal(normalizePersonSearchMode(undefined), "all");
+});
+
+test("华人和日韩名：华人、日本、韩国演员翻译，音译名和没有中文名的人保留原文，名字不调用机器翻译", async () => {
+    const { result, httpLogs } = await runResponseCase({
+        url: "https://api.trakt.tv/search/person?query=x",
+        body: createSearchBody(ALL_KEYS),
+        argument: { ...ON, personSearchTranslationMode: "华人和日韩名" },
+        httpGetMocks: createTmdbPersonMocks(ALL_KEYS),
+        persistentData: createUnifiedPersistentData(),
+    });
+
+    assert.deepEqual(namesOf(result), ["周星驰", "吴彦祖", "木村拓哉", "宋康昊", "Tom Hanks", "Some Extra"]);
+    assert.equal(httpLogs.some(isMachineTranslationRequest), false);
+});
+
+test("仅华人名：排除出生在日本、韩国的人，海外出生的华裔照常翻译", async () => {
+    const { result } = await runResponseCase({
+        url: "https://api.trakt.tv/search/person?query=x",
+        body: createSearchBody(ALL_KEYS),
+        argument: { ...ON, personSearchTranslationMode: "仅华人名" },
+        httpGetMocks: createTmdbPersonMocks(ALL_KEYS),
+        persistentData: createUnifiedPersistentData(),
+    });
+
+    assert.deepEqual(namesOf(result), ["周星驰", "吴彦祖", "Takuya Kimura", "Song Kang-ho", "Tom Hanks", "Some Extra"]);
+});
+
+test("判定结果记在本地：第二次搜同样的人不再请求 TMDb", async () => {
+    const first = await runResponseCase({
+        url: "https://api.trakt.tv/search/person?query=x",
+        body: createSearchBody(ALL_KEYS),
+        argument: { ...ON, personSearchTranslationMode: "chinese" },
+        httpGetMocks: createTmdbPersonMocks(ALL_KEYS),
+        persistentData: createUnifiedPersistentData(),
+    });
+    assert.equal(first.httpLogs.filter(isTmdbPersonRequest).length, ALL_KEYS.length);
+    const regions = JSON.parse(first.persistentData[REGION_STORE_KEY]);
+    assert.equal(regions[String(PEOPLE.kimura.trakt)], "jk");
+    assert.equal(regions[String(PEOPLE.chow.trakt)], "c");
+
+    const second = await runResponseCase({
+        url: "https://api.trakt.tv/search/person?query=x",
+        body: createSearchBody(ALL_KEYS),
+        argument: { ...ON, personSearchTranslationMode: "chinese" },
+        persistentData: first.persistentData,
+    });
+    assert.equal(second.httpLogs.filter(isTmdbPersonRequest).length, 0);
+    assert.deepEqual(namesOf(second.result), ["周星驰", "吴彦祖", "Takuya Kimura", "Song Kang-ho", "Tom Hanks", "Some Extra"]);
+});
+
+test("本月生日人物列表同样按档位处理", async () => {
+    const body = JSON.stringify(["chow", "hanks"].map((key) => ({ name: PEOPLE[key].name, ids: { trakt: PEOPLE[key].trakt, tmdb: PEOPLE[key].tmdb } })));
+    const { result } = await runResponseCase({
+        url: "https://api.trakt.tv/people/this_month",
+        body,
+        argument: { ...ON, personSearchTranslationMode: "eastAsian" },
+        httpGetMocks: createTmdbPersonMocks(["chow", "hanks"]),
+        persistentData: createUnifiedPersistentData(),
+    });
+    assert.deepEqual(
+        JSON.parse(result.body).map((item) => item.name),
+        ["周星驰", "Tom Hanks"],
+    );
+});
diff --git a/tests/trakt_translation_scope.test.mjs b/tests/trakt_translation_scope.test.mjs
new file mode 100644
index 0000000..3cf4431
