diff --git a/tests/trakt_translation_scope.test.mjs b/tests/trakt_translation_scope.test.mjs
new file mode 100644
index 0000000..5589b77
--- /dev/null
+++ b/tests/trakt_translation_scope.test.mjs
@@ -0,0 +1,375 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { isChineseLanguage } from "../trakt_simplified_chinese/src/shared/translation-scope.mjs";
+
+import { TEST_TMDB_API_KEY } from "./helpers/run-script.mjs";
+import {
+    createMediaTranslationCache,
+    createMediaTranslationEntry,
+    createPeopleTranslationCache,
+    createTmdbImagesResponse,
+    createUnifiedPersistentData,
+    parseUnifiedCache,
+    readFixture,
+    runResponseCase,
+} from "./helpers/trakt-test-helpers.mjs";
+
+const LANGUAGE_STORE_KEY = "dj_trakt_fork_media_language";
+const ON = { chineseOnlyTranslation: true };
+
+function createPersistentData(translations = {}, languages = null) {
+    const data = createUnifiedPersistentData({
+        traktTranslation: JSON.parse(createMediaTranslationCache(translations)),
+    });
+    if (languages) {
+        data[LANGUAGE_STORE_KEY] = JSON.stringify(languages);
+    }
+    return data;
+}
+
+function readLanguageStore(persistentData) {
+    return JSON.parse(String(persistentData?.[LANGUAGE_STORE_KEY] ?? "{}"));
+}
+
+function hasTranslationRequest(httpLogs) {
+    return httpLogs.some((log) => /\/translations\/zh|\/v3\/intl\/bulk|translate|deepl/.test(log.url));
+}
+
+// passThrough 时脚本不改写响应，runScript 拿到的 body 为 undefined
+function assertPassThrough(result) {
+    assert.equal(result.body, undefined);
+}
+
+test("isChineseLanguage 只把中文当作中文原片，未知返回 null", () => {
+    assert.equal(isChineseLanguage("zh"), true);
+    assert.equal(isChineseLanguage("cn"), true);
+    assert.equal(isChineseLanguage("zh-TW"), true);
+    assert.equal(isChineseLanguage("en"), false);
+    assert.equal(isChineseLanguage("ja"), false);
+    assert.equal(isChineseLanguage(""), null);
+    assert.equal(isChineseLanguage(null), null);
+});
+
+test("英语电影详情原样放行，不请求翻译，并记住语言", async () => {
+    const detail = { ...JSON.parse(readFixture("movie-detail.json")), language: "en" };
+    const { result, httpLogs, persistentData } = await runResponseCase({
+        url: "https://api.trakt.tv/movies/123",
+        body: JSON.stringify(detail),
+        argument: ON,
+        persistentData: createPersistentData({ "movie:123": createMediaTranslationEntry({ translation: { title: "中文标题", overview: "中文简介" } }) }),
+    });
+
+    assertPassThrough(result);
+    assert.equal(hasTranslationRequest(httpLogs), false);
+    assert.equal(readLanguageStore(persistentData)["movie:123"], "en");
+});
+
+test("中文电影详情照常应用中文翻译", async () => {
+    const detail = { ...JSON.parse(readFixture("movie-detail.json")), language: "zh" };
+    const { result } = await runResponseCase({
+        url: "https://api.trakt.tv/movies/123",
+        body: JSON.stringify(detail),
+        argument: ON,
+        persistentData: createPersistentData({
+            "movie:123": createMediaTranslationEntry({ translation: { title: "中文标题", overview: "中文简介", tagline: "中文标语" } }),
+        }),
+    });
+
+    const payload = JSON.parse(result.body);
+    assert.equal(payload.title, "中文标题");
+    assert.equal(payload.overview, "中文简介");
+});
+
+function createWatchlistItems() {
+    return [
+        { type: "show", show: { title: "English Show", language: "en", ids: { trakt: 11 }, images: { poster: ["trakt/english.jpg"] } } },
+        { type: "show", show: { title: "Chinese Show", language: "zh", ids: { trakt: 22 } } },
+        { type: "show", show: { title: "Japanese Show", language: "ja", ids: { trakt: 33 } } },
+        {
+            type: "episode",
+            show: { title: "English Show", language: "en", ids: { trakt: 11 } },
+            episode: { season: 1, number: 3, title: "Episode 3", ids: { trakt: 1103 } },
+        },
+    ];
+}
+
+const WATCHLIST_TRANSLATIONS = {
+    "show:11": createMediaTranslationEntry({ translation: { title: "英语剧中文名" } }),
+    "show:22": createMediaTranslationEntry({ translation: { title: "中文剧中文名" } }),
+    "show:33": createMediaTranslationEntry({ translation: { title: "日剧中文名" } }),
+    "episode:11:1:3": createMediaTranslationEntry({ translation: { title: "英语剧第三集" } }),
+};
+
+test("列表里只翻译中文剧集，其他语言条目（无 TMDb 海报可换时）与 Trakt 返回完全一致", async () => {
+    const items = createWatchlistItems();
+    const { result } = await runResponseCase({
+        url: "https://api.trakt.tv/users/me/watchlist",
+        body: JSON.stringify(items),
+        argument: { ...ON, posterImageMode: "chinese" },
+        persistentData: createPersistentData(WATCHLIST_TRANSLATIONS),
+    });
+
+    const payload = JSON.parse(result.body);
+    assert.equal(payload[1].show.title, "中文剧中文名");
+    assert.deepEqual(payload[0], items[0]);
+    assert.deepEqual(payload[2], items[2]);
+    assert.deepEqual(payload[3], items[3]);
+});
+
+test("关闭“只翻译中文影视”时与上游一致，所有条目都翻译", async () => {
+    const { result } = await runResponseCase({
+        url: "https://api.trakt.tv/users/me/watchlist",
+        body: JSON.stringify(createWatchlistItems()),
+        argument: { chineseOnlyTranslation: false },
+        persistentData: createPersistentData(WATCHLIST_TRANSLATIONS),
+    });
+
+    const payload = JSON.parse(result.body);
+    assert.equal(payload[0].show.title, "英语剧中文名");
+    assert.equal(payload[2].show.title, "日剧中文名");
+    assert.equal(payload[3].episode.title, "英语剧第三集");
+});
+
+test("列表条目没有 language 时补查一次剧集详情，并记住语言供下次使用", async () => {
+    const body = JSON.stringify([{ type: "show", show: { title: "Unknown Show", ids: { trakt: 44 } } }]);
+    const detailUrl = "https://api.trakt.tv/shows/44?extended=cloud9,full,watchnow";
+    const { result, httpLogs, persistentData } = await runResponseCase({
+        url: "https://api.trakt.tv/users/me/watchlist",
+        body,
+        argument: ON,
+        httpGetMocks: { [detailUrl]: JSON.stringify({ title: "Unknown Show", language: "en", ids: { trakt: 44, slug: "unknown-show" } }) },
+        persistentData: createPersistentData({ "show:44": createMediaTranslationEntry({ translation: { title: "未知剧中文名" } }) }),
+    });
+
+    assert.equal(JSON.parse(result.body)[0].show.title, "Unknown Show");
+    assert.equal(httpLogs.filter((log) => log.url === detailUrl).length, 1);
+    assert.equal(readLanguageStore(persistentData)["show:44"], "en");
+    assert.equal(readLanguageStore(persistentData)["show:unknown-show"], "en");
+
+    const second = await runResponseCase({
+        url: "https://api.trakt.tv/users/me/watchlist",
+        body,
+        argument: ON,
+        persistentData,
+    });
+    assert.equal(JSON.parse(second.result.body)[0].show.title, "Unknown Show");
+    assert.equal(second.httpLogs.filter((log) => log.url === detailUrl).length, 0);
+});
+
+test("补查详情失败、语言仍未知时按中文处理，不漏翻中文剧集", async () => {
+    const { result } = await runResponseCase({
+        url: "https://api.trakt.tv/users/me/watchlist",
+        body: JSON.stringify([{ type: "show", show: { title: "Unknown Show", ids: { trakt: 55 } } }]),
+        argument: ON,
+        httpGetMocks: { "https://api.trakt.tv/shows/55?extended=cloud9,full,watchnow": { status: 500, body: "{}" } },
+        persistentData: createPersistentData({ "show:55": createMediaTranslationEntry({ translation: { title: "未知剧中文名" } }) }),
+    });
+
+    assert.equal(JSON.parse(result.body)[0].show.title, "未知剧中文名");
+});
+
+test("英语剧集的季列表不翻译（无季海报可换时原样放行），但仍缓存集 ID 供播放器跳转按钮使用", async () => {
+    const { result, httpLogs, persistentData } = await runResponseCase({
+        url: "https://api.trakt.tv/shows/555/seasons?extended=episodes,full",
+        body: readFixture("season-list.json"),
+        argument: { ...ON, posterImageMode: "chinese" },
+        persistentData: createPersistentData({}, { "show:555": "en" }),
+    });
+
+    assertPassThrough(result);
+    assert.equal(hasTranslationRequest(httpLogs), false);
+    assert.ok(parseUnifiedCache(persistentData).trakt.linkIds["1001"]);
+});
+
+test("App 请求非中文剧集的中文翻译时原样放行，中文剧集照常处理", async () => {
+    const english = await runResponseCase({
+        url: "https://api.trakt.tv/shows/555/translations/zh?extended=all",
+        body: readFixture("translations.json"),
+        argument: ON,
+        persistentData: createPersistentData({}, { "show:555": "en" }),
+    });
+    assertPassThrough(english.result);
+
+    const episode = await runResponseCase({
+        url: "https://api.trakt.tv/shows/555/seasons/1/episodes/2/translations/zh?extended=all",
+        body: readFixture("translations.json"),
+        argument: ON,
+        persistentData: createPersistentData({}, { "show:555": "en" }),
+    });
+    assertPassThrough(episode.result);
+
+    const chinese = await runResponseCase({
+        url: "https://api.trakt.tv/shows/666/translations/zh?extended=all",
+        body: readFixture("translations.json"),
+        argument: ON,
+        persistentData: createPersistentData({}, { "show:666": "zh" }),
+    });
+    assert.ok(JSON.parse(chinese.result.body).length > 0);
+});
+
+test("英语影视的预告片、口碑摘要、演职员表原样放行", async () => {
+    const languages = { "movie:123": "en" };
+    const cases = [
+        { url: "https://api.trakt.tv/movies/123/videos", fixture: "videos.json" },
+        { url: "https://api.trakt.tv/movies/123/sentiments", fixture: "sentiments.json" },
+        { url: "https://api.trakt.tv/v3/media/movie/123/info/1/version/2", fixture: "sentiments.json" },
+        { url: "https://api.trakt.tv/movies/123/people", fixture: "media-people-list.json" },
+    ];
+    for (const { url, fixture } of cases) {
+        const { result, httpLogs } = await runResponseCase({
+            url,
+            body: readFixture(fixture),
+            argument: { ...ON, translationEngine: "google" },
+            persistentData: createPersistentData({}, languages),
+        });
+        assertPassThrough(result);
+        assert.equal(hasTranslationRequest(httpLogs), false, url);
+    }
+});
+
+test("英语影视的评论原样放行，之后打开这些评论的回复也不翻译", async () => {
+    const languages = { "movie:123": "en" };
+    const first = await runResponseCase({
+        url: "https://api.trakt.tv/movies/123/comments/newest",
+        body: readFixture("comments.json"),
+        argument: ON,
+        persistentData: createPersistentData({}, languages),
+    });
+    assertPassThrough(first.result);
+    assert.equal(readLanguageStore(first.persistentData)["comment:9001"], "-");
+
+    const replies = await runResponseCase({
+        url: "https://api.trakt.tv/comments/9001/replies",
+        body: readFixture("comments.json"),
+        argument: ON,
+        persistentData: first.persistentData,
+    });
+    assertPassThrough(replies.result);
+});
+
+test("片单名称和描述不处理", async () => {
+    for (const url of ["https://api.trakt.tv/users/me/lists", "https://api.trakt.tv/lists/trending"]) {
+        const { result, httpLogs } = await runResponseCase({ url, body: readFixture("list-descriptions.json"), argument: ON, persistentData: createPersistentData() });
+        assertPassThrough(result);
+        assert.equal(hasTranslationRequest(httpLogs), false, url);
+    }
+});
+
+test("人物页翻译开关：关闭时人物页、人物搜索原样放行", async () => {
+    const cases = [
+        { url: "https://api.trakt.tv/people/tom-hanks", fixture: "people-detail.json" },
+        { url: "https://api.trakt.tv/search/person?query=tom", fixture: "media-people-list.json" },
+        { url: "https://api.trakt.tv/people/this_month", fixture: "media-people-list.json" },
+    ];
+    for (const { url, fixture } of cases) {
+        const { result, httpLogs } = await runResponseCase({
+            url,
+            body: readFixture(fixture),
+            argument: { ...ON, peopleTranslationEnabled: false },
+            persistentData: createPersistentData(),
+        });
+        assertPassThrough(result);
+        assert.equal(hasTranslationRequest(httpLogs), false, url);
+    }
+});
+
+test("人物页翻译开关：开启时（默认）人物页照常翻译", async () => {
+    const { result } = await runResponseCase({
+        url: "https://api.trakt.tv/people/42",
+        body: readFixture("people-detail.json"),
+        argument: ON,
+        persistentData: createUnifiedPersistentData({ googlePeople: JSON.parse(createPeopleTranslationCache()) }),
+    });
+
+    assert.notEqual(result.body, undefined);
+    assert.match(JSON.parse(result.body).name, /汤姆·汉克斯/);
+});
+
+test("最近评论列表只翻译中文影视条目，英语条目保持原样并记住评论", async () => {
+    const items = [
+        { movie: { title: "English Movie", language: "en", ids: { trakt: 123 } }, comment: { id: 7001, language: "en", comment: "Nice" } },
+        { movie: { title: "Chinese Movie", language: "zh", ids: { trakt: 456 } }, comment: { id: 7002, language: "zh", comment: "很好" } },
+    ];
+    const { result, persistentData } = await runResponseCase({
+        url: "https://api.trakt.tv/comments/recent/all/weekly",
+        body: JSON.stringify(items),
+        argument: ON,
+        persistentData: createPersistentData({ "movie:456": createMediaTranslationEntry({ translation: { title: "中文电影名" } }) }),
+    });
+
+    const payload = JSON.parse(result.body);
+    assert.deepEqual(payload[0], items[0]);
+    assert.equal(payload[1].movie.title, "中文电影名");
+    assert.equal(readLanguageStore(persistentData)["comment:7001"], "-");
+});
+
+// ---------- 海报：所有影视都按「海报语言」处理（与原插件一致） ----------
+
+const TMDB_MOVIE_IMAGES_URL = `https://api.tmdb.org/3/movie/456/images?language=zh%2Cen&api_key=${TEST_TMDB_API_KEY}`;
+const TRAKT_POSTER = "https://walter.trakt.tv/images/movies/000/000/123/posters/original.jpg";
+const TMDB_CN_POSTER = "https://image.tmdb.org/t/p/w780/cn-poster.jpg";
+
+function createMovie(overrides = {}) {
+    return {
+        title: "Original Movie",
+        overview: "Original Overview",
+        ids: { trakt: 123, tmdb: 456 },
+        language: "en",
+        country: "us",
+        available_translations: ["en", "zh"],
+        images: { poster: [TRAKT_POSTER] },
+        ...overrides,
+    };
+}
+
+function createChinesePosterMock() {
+    return { [TMDB_MOVIE_IMAGES_URL]: createTmdbImagesResponse([{ iso_639_1: "zh", iso_3166_1: "CN", file_path: "/cn-poster.jpg", vote_average: 8, vote_count: 20 }]) };
+}
+
+test("英语电影详情：文字保留原文，海报按「海报语言=中文」换成中文海报", async () => {
+    const { result, httpLogs } = await runResponseCase({
+        url: "https://api.trakt.tv/movies/123",
+        body: JSON.stringify(createMovie()),
+        argument: { ...ON, posterImageMode: "chinese" },
+        httpGetMocks: createChinesePosterMock(),
+        persistentData: createPersistentData({ "movie:123": createMediaTranslationEntry({ translation: { title: "中文标题", overview: "中文简介" } }) }),
+    });
+
+    const payload = JSON.parse(result.body);
+    assert.equal(payload.title, "Original Movie");
+    assert.equal(payload.overview, "Original Overview");
+    assert.equal(payload.images.poster[0], TMDB_CN_POSTER);
+    assert.equal(hasTranslationRequest(httpLogs), false);
+});
+
+test("列表里的英语电影：文字保留原文，海报按「海报语言=中文」换成中文海报", async () => {
+    const { result } = await runResponseCase({
+        url: "https://api.trakt.tv/users/me/watchlist",
+        body: JSON.stringify([{ type: "movie", movie: createMovie() }]),
+        argument: { ...ON, posterImageMode: "chinese" },
+        httpGetMocks: createChinesePosterMock(),
+        persistentData: createPersistentData({ "movie:123": createMediaTranslationEntry({ translation: { title: "中文标题" } }) }),
+    });
+
+    const payload = JSON.parse(result.body);
+    assert.equal(payload[0].movie.title, "Original Movie");
+    assert.equal(payload[0].movie.images.poster[0], TMDB_CN_POSTER);
+});
+
+test("中文电影详情：文字照常翻译，「海报语言=原图」时保留 Trakt 海报", async () => {
+    const { result, httpLogs } = await runResponseCase({
+        url: "https://api.trakt.tv/movies/123",
+        body: JSON.stringify(createMovie({ language: "zh", country: "cn" })),
+        argument: { ...ON, posterImageMode: "default" },
+        persistentData: createPersistentData({ "movie:123": createMediaTranslationEntry({ translation: { title: "中文标题", overview: "中文简介", tagline: "中文标语" } }) }),
+    });
+
+    const payload = JSON.parse(result.body);
+    assert.equal(payload.title, "中文标题");
+    assert.equal(payload.images.poster[0], TRAKT_POSTER);
+    assert.equal(
+        httpLogs.some((log) => log.url.startsWith("https://api.tmdb.org/3/")),
+        false,
+    );
+});
