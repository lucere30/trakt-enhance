{
    "rewrites": [
        {
            "source": "/admin",
            "destination": "/admin.html"
        },
        {
            "source": "/admin/",
            "destination": "/admin.html"
        }
    ],
    "functions": {
        "api/redirect.js": {
            "maxDuration": 10
        },
        "api/trakt/translations.js": {
            "maxDuration": 30
        },
        "api/trakt/images.js": {
            "maxDuration": 30
        },
        "api/trakt/credits.js": {
            "maxDuration": 30
        },
        "api/trakt/people-names.js": {
            "maxDuration": 30
        },
        "api/trakt/comment-translations.js": {
            "maxDuration": 30
        },
        "api/trakt/list-translations.js": {
            "maxDuration": 30
        },
        "api/trakt/apikeys.js": {
            "maxDuration": 10
        }
    },
    "git": {
        "deploymentEnabled": {
            "*": false,
            "**": false,
            "main": true
        }
    },
    "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
    "proxy": {
        "entrypoint": "middleware.js",
        "matcher": [
            "/api/trakt/translations",
            "/api/trakt/images",
            "/api/trakt/credits",
            "/api/trakt/people-names",
            "/api/trakt/comment-translations",
            "/api/trakt/list-translations",
            "/api/trakt/translation-overrides",
            "/api/trakt/apikeys"
        ]
    },
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "no-referrer"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
                },
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin"
                }
            ]
        },
        {
            "source": "/",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
                }
            ]
        },
        {
            "source": "/index.html",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
                }
            ]
        }
    ]
}
